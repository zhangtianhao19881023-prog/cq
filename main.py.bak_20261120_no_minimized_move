        except Exception:
            pass
        try:
            self.game.detach()
        except Exception:
            pass
        try:
            self.game.dm_input.unbind()
        except Exception:
            pass
        try:
            self.game.dm_input.close()
        except Exception:
            pass
        try:
            if hasattr(self, "dm_window_label"):
                self.dm_window_label.configure(text="窗口: 当前游戏窗口")
            if hasattr(self, "dm_status_label"):
